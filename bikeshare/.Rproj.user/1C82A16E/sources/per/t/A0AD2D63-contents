### Rides by Weekday with Counts

```{r}
weekday_data <- all_trips %>%
  group_by(member_casual, day_of_week) %>%
  summarise(n = n()) %>%
  group_by(member_casual) %>%
  mutate(percent = n / sum(n), label = paste0(n, " (", percent(percent, accuracy = 0.1), ")"))

ggplot(weekday_data, aes(x = day_of_week, y = n, fill = member_casual)) +
  geom_col(position = position_dodge()) +
  geom_text(aes(label = label), position = position_dodge(width = 0.9), vjust = -0.5, size = 3) +
  labs(title = "Rides by Day of Week", x = "Day", y = "Total Rides") +
  theme_minimal()
```

### Rider Duration Distribution + Normal Overlay

```{r}
# Compute mean and sd manually by group
dist_params <- all_trips %>%
  filter(ride_length < 60) %>%
  group_by(member_casual) %>%
  summarise(
    mu = mean(ride_length),
    sigma = sd(ride_length)
  )

# Plot with overlay using constants
plot_dist <- all_trips %>%
  filter(ride_length < 60) %>%
  ggplot(aes(x = ride_length, fill = member_casual)) +
  geom_histogram(aes(y = ..density..), alpha = 0.4, position = "identity", bins = 60) +
  stat_function(
    fun = dnorm,
    args = list(mean = dist_params$mu[dist_params$member_casual == "member"],
                sd = dist_params$sigma[dist_params$member_casual == "member"]),
    color = "blue"
  ) +
  stat_function(
    fun = dnorm,
    args = list(mean = dist_params$mu[dist_params$member_casual == "casual"],
                sd = dist_params$sigma[dist_params$member_casual == "casual"]),
    color = "red"
  ) +
  facet_wrap(~member_casual) +
  labs(title = "Ride Duration Distribution", x = "Minutes", y = "Density") +
  theme_minimal()

plot_dist
```

